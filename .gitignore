# ============================================================
# NetraScan.AI V2
# Repository exclusions
# ============================================================

# Python cache and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtual environments and portable runtime
.venv/
venv/
env/
runtime/
.python-version

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Jupyter temporary files
.ipynb_checkpoints/

# Vision model checkpoints
models/
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors

# Local GenAI models and runtime binaries
llm/weights/
llm/backend/
llm/downloads/
*.gguf
*.exe
*.dll
*.lib
*.pyd
*.zip
*.7z

# Large datasets
data/raw/
data/processed/
data/images/
datasets/
Dataset Katarak/
Cataract v01*/
SLID/

# Generated reports and local testing artifacts
reports/
logs/
tests/
results/generated/
gradio_cached_examples/
flagged/
temp/
tmp/
*.log

# Private images and media
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.webp
*.gif
*.mp4

# Credentials and sensitive configuration
.env
.env.*
!.env.example
*.pem
*.key

# Approved research figures
!results/**/*.png
!results/**/*.jpg
!results/**/*.jpeg

# Approved benchmark figures
!benchmarks/**/01_gpu_memory_utilization.png
!benchmarks/**/02_cold_warm_latency.png
!benchmarks/**/03_transformer_inference_latency.png
!benchmarks/**/04_llm_generation_throughput.png
!benchmarks/**/05_narrative_validation.png
!benchmarks/**/06_adversarial_validation.png

# Public application assets
!assets/background.png
!assets/background.jpg
!assets/background.jpeg
!assets/background.webp
